{
  "id": "/",
  "name": "AbookScan IA",
  "short_name": "AbookScan",
  "description": "Scanner professionnel haute précision avec transcription intelligente, OCR et dictée vocale.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "categories": ["productivity", "utilities", "business", "photo"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Scanner Document",
      "short_name": "Scanner",
      "description": "Numériser et extraire le texte d'un document",
      "url": "/?tab=ocr",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dictée Vocale",
      "short_name": "Dictée",
      "description": "Enregistrer et transcrire la voix",
      "url": "/?tab=voice",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mes Documents",
      "short_name": "Archives",
      "description": "Consulter les scans et transcriptions enregistrés",
      "url": "/?action=history",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/?share_target=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/*",
            "image/*",
            "application/pdf",
            "text/plain",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?file_handler=true",
      "name": "Ouvrir avec AbookScan IA",
      "accept": {
        "audio/*": [".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac", ".webm", ".amr"],
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".heic"],
        "application/pdf": [".pdf"],
        "text/plain": [".txt"]
      }
    }
  ]
}
