rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stats collection: global usage analytics
    match /analytics_stats/{statId} {
      allow read, write: if true;
    }
    
    // User sessions & activity logs for unique audience counting
    match /analytics_users/{userId} {
      allow read, write: if true;
    }
    
    // Activity events (scans, audio, exports)
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }
  }
}
